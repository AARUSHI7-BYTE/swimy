rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && currentUser().role == 'admin';
    }

    function isFacility() {
      return isSignedIn() && currentUser().role == 'facility';
    }

    function isAssignedToPool(poolId) {
      return (isAdmin() || isFacility()) && poolId in currentUser().poolIds;
    }

    // users/{uid}.phoneNumber is stored as "+91XXXXXXXXXX" while
    // membership.phone is the raw 10-digit number. This must compare
    // resource.data.phone *bare* (never wrapped in a concatenation/transform)
    // so Firestore can statically prove the rule is satisfied by a
    // where("phone", "==", ...) query - a transformed resource.data
    // comparison makes the query unprovable and Firestore rejects the whole
    // list request with permission-denied, independent of the actual data.
    function requesterRawPhone() {
      return currentUser().phoneNumber.split("\\+91")[1];
    }

    // Each user manages only their own profile doc. Role and poolIds can only
    // be set to defaults on creation and never changed by the user themself -
    // admin/facility access must be granted manually (e.g. via Firebase console).
    // Admin/facility staff can also read any user doc (including by phone
    // number query) to detect a returning member during membership sign-up.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isFacility();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.poolIds.size() == 0;
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.poolIds == resource.data.poolIds;
      allow delete: if false;
    }

    // Pool catalog is readable by any signed-in user (to browse/search).
    // Admins manage the catalog itself (add/edit pools). Facility accounts
    // assigned to a pool (and admins) may read/write data scoped under that
    // pool (bookings, entries, etc.).
    match /pools/{poolId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Admins can change anything. Facility accounts assigned to this pool
      // may only touch the self-service fields exposed in the Facility App's
      // Settings tab (pricing, capacity, profile) - identity fields like
      // name/location/active/poolIds stay admin-only.
      allow update: if isAdmin()
        || (isAssignedToPool(poolId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'pricingModel', 'baseCharge', 'perMinCharge', 'slotPrice', 'overagePerMin',
                   'slabs', 'lateExitPerMin', 'maxOccupancy', 'liveOccupancy',
                   'operatingHours', 'contactInfo', 'photos', 'primaryPhotoIndex'
                 ]));

      match /{document=**} {
        allow read, write: if isAssignedToPool(poolId);
      }

      // Members need to read their own membership doc (keyed by phone number)
      // so activate/deactivate toggles made by facility staff are reflected
      // on the member-facing account screen.
      match /memberships/{membershipId} {
        allow read: if isSignedIn() && resource.data.phone == requesterRawPhone();
        // Members may pause/resume their own membership from the account
        // screen - only the status field, everything else stays staff-only.
        allow update: if isSignedIn()
          && resource.data.phone == requesterRawPhone()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'inactive'];
      }

      // Consumers need to read their own entry docs (home.tsx subscribes to
      // the signed-in user's latest entry to show check-in/out status and
      // amount due). Only staff assigned to the pool can write entries -
      // check-in/check-out always happens via a facility scan.
      match /entries/{entryId} {
        allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
